{
  // Cloudflare Worker 'live-tolk' — wordt automatisch gepubliceerd vanuit GitHub (Builds).
  // Geheime sleutels (GITHUB_TOKEN, DEEPL_KEY) en instellingen (REPO, ALLOWED_ORIGIN) staan
  // in het Cloudflare-dashboard en blijven behouden (keep_vars).
  "name": "live-tolk",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  // Gewone (niet-geheime) instellingen staan hier; geheime sleutels alleen in het Cloudflare-dashboard.
  "vars": {
    "REPO": "Menheerse/live-tolk-data",
    "ALLOWED_ORIGIN": "https://menheerse.github.io"
  },
  // Workers AI (Whisper) voor spraak naar tekst op iPhone e.d.
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": { "enabled": true }
}
